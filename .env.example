# IceCode 环境变量示例 — 复制为 .env 后填写
# 启动时由 python-dotenv 加载；也可在 shell 中 export 覆盖

# --- Provider 与模型 ---

# 使用哪家 LLM：deepseek | anthropic
LLM_PROVIDER=deepseek

# DeepSeek（LLM_PROVIDER=deepseek 时）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic（LLM_PROVIDER=anthropic 时取消注释并填写）
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- 请求与 Agent ---

# 单次回复最大 output tokens；也用于 microcompact 有效窗口 = 模型窗口 − MAX_TOKENS
MAX_TOKENS=4096
TEMPERATURE=0.3
# 单轮用户任务内 Agent 最大循环次数
MAX_TURNS=30

# --- 工作目录、权限 ---

# 工具沙箱根目录（read/write/bash 等限制在此树下）；可写绝对路径
WORKDIR=.

# 危险：true 时跳过全部副作用确认
AUTO_APPROVE=false

# 纯对话（无工具）：false 时不注册工具
ICECODE_ENABLE_TOOLS=true

# 真流式输出：false 时回退为非流式 create_message（排障）
ICECODE_STREAM=true

# 权限模式：default | accept_edits | dont_ask
PERMISSION_MODE=default

# --- 会话持久化 ---

# 会话 transcript 等本地数据目录（默认 ~/.icecode）
# ICECODE_HOME=~/.icecode

# --- 上下文 microcompact ---
# 长会话超阈值时，本地将旧 tool_result 替换为占位串（不调大模型）。
# 触发阈值 ≈ (模型窗口或 CONTEXT_WINDOW_OVERRIDE − MAX_TOKENS) − MICROCOMPACT_BUFFER_TOKENS
# 手测时可临时缩小窗口，并同步减小 MAX_TOKENS，例如：
#   ICECODE_CONTEXT_WINDOW_OVERRIDE=2000
#   ICECODE_MICROCOMPACT_BUFFER_TOKENS=500
#   ICECODE_MICROCOMPACT_KEEP_RECENT=2
#   MAX_TOKENS=512

# 总开关；false 关闭 microcompact
ICECODE_ENABLE_MICROCOMPACT=true

# 保留最近 N 个可压缩工具结果（read_file/bash/grep 等）不清理
ICECODE_MICROCOMPACT_KEEP_RECENT=3

# 有效窗口减去该 buffer 即为触发阈值
ICECODE_MICROCOMPACT_BUFFER_TOKENS=8000

# 可选：正整数，覆盖模型默认上下文窗口（调试用；不设则按模型查表）
# ICECODE_CONTEXT_WINDOW_OVERRIDE=
